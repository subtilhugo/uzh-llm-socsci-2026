Bootstrap: docker
From: condaforge/miniforge3:latest

# The S3IT recipe for a Python environment on the ScienceCluster (docs.s3it.uzh.ch/cluster/how_to_use_conda/).
# One container, two doors: batch jobs (apptainer exec s4.sif python ...) and a Jupyter kernel in ScienceApps.

%files
    ./env.yml /env.yml

%post
    mamba env create --yes -f /env.yml
    mamba clean --all -f -y

%environment
    export PATH="/opt/conda/envs/venv/bin:$PATH"

%runscript
    exec python "$@"
